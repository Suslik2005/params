def convert_value(value, data_type):
    """Преобразует значение в зависимости от типа данных"""
    if isinstance(value, (int, float)):
        return value
    if data_type == 'float':
        return float(value)
    elif data_type in ['int', 'ulong', 'bmask']:
        return int(value)
    else:
        return value


def test_parameter(mb, param_name, param_data):
    """Тестирование одного параметра"""
    address, data_type, min_val, max_val = param_data

    # Преобразуем min_val и max_val в числа
    min_val = convert_value(min_val, data_type)
    max_val = convert_value(max_val, data_type)

    print(f"\n{'█' * 80}")
    print(f"█{' ' * 78}█")
    print(f"█  ТЕСТИРОВАНИЕ: {param_name:<58} █")
    print(f"█  Адрес: {address} | Тип: {data_type:<40} █")
    print(f"█  Диапазон: [{min_val}, {max_val}]{' ':<44} █")
    print(f"█{' ' * 78}█")
    print(f"{'█' * 80}\n")

    # Читаем текущее значение
    current_value = mb.read(address, data_type)
    if data_type == 'float':
        # Определяем количество знаков после запятой у min_val
        min_val_str = str(min_val)
        if '.' in min_val_str:
            decimal_places = len(min_val_str.split('.')[1])
        else:
            decimal_places = 2

        current_value_display = round(current_value, decimal_places)
        print(f"ТЕКУЩЕЕ значение: {current_value} -> округлено до {decimal_places} знаков: {current_value_display}")
    else:
        current_value_display = current_value
        print(f"ТЕКУЩЕЕ значение: {current_value}")

    # Тестовые значения
    test_cases = [
        (min_val, "МИНИМАЛЬНОЕ значение"),
        (max_val, "МАКСИМАЛЬНОЕ значение"),
        (min_val - 1, "НИЖЕ минимума на 1"),
        (max_val + 1, "ВЫШЕ максимума на 1")
    ]

    for test_val, description in test_cases:
        print(f"\n{'─' * 60}")
        print(f"→ {description}")
        print(f"{'─' * 60}")
        print(f"Пытаемся записать: {test_val}")

        try:
            mb.write(address, test_val, data_type)
            print(f"✓ Запись выполнена")

            # Читаем записанное значение
            read_val = mb.read(address, data_type)

            if data_type == 'float':
                # Определяем количество знаков после запятой у test_val
                test_val_str = str(test_val)
                if '.' in test_val_str:
                    decimal_places = len(test_val_str.split('.')[1])
                else:
                    decimal_places = 2

                written_rounded = round(test_val, decimal_places)
                read_rounded = round(read_val, decimal_places)

                print(f"Записано: {test_val} -> округлено до {decimal_places} знаков: {written_rounded}")
                print(f"Прочитано: {read_val} -> округлено до {decimal_places} знаков: {read_rounded}")

                if written_rounded == read_rounded:
                    print(f"✓ Значение записалось корректно")
                else:
                    print(f"⚠ Прочитанное значение отличается от записанного")
            else:
                print(f"Записано: {test_val}")
                print(f"Прочитано: {read_val}")
                if test_val == read_val:
                    print(f"✓ Значение записалось корректно")
                else:
                    print(f"⚠ Прочитанное значение отличается от записанного")

        except Exception as e:
            print(f"✗ Ошибка при записи: {e}")

    # Восстанавливаем исходное значение
    print(f"\n{'─' * 60}")
    print(f"→ ВОССТАНОВЛЕНИЕ")
    print(f"{'─' * 60}")
    print(f"Восстанавливаем исходное значение: {current_value_display}")
    try:
        mb.write(address, current_value, data_type)
        check_value = mb.read(address, data_type)

        if data_type == 'float':
            current_val_str = str(current_value)
            if '.' in current_val_str:
                decimal_places = len(current_val_str.split('.')[1])
            else:
                decimal_places = 2

            check_rounded = round(check_value, decimal_places)
            print(f"Восстановлено: {check_value} -> округлено до {decimal_places} знаков: {check_rounded}")
            if current_value_display == check_rounded:
