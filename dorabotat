def create_dict_from_excel(file_path: str, str_array,
                           key_column: int = 7,
                           value_columns: Tuple[int, int] = (3, 4)) -> Dict[str, Tuple[any, any]]:
    """
    Создает словарь на основе совпадений значений из массива с данными в Excel

    Args:
        file_path: путь к файлу Excel
        str_array: массив строк для поиска
        key_column: номер столбца для поиска совпадений (по умолчанию 7)
        value_columns: кортеж из номеров столбцов для значений (по умолчанию (3, 4))

    Returns:
        словарь вида {значение_из_массива: (значение_3_столбца, значение_4_столбца)}
    """
    # Загружаем Excel файл
    workbook = openpyxl.load_workbook(file_path, data_only=True)
    sheet = workbook.active

    # Создаем словарь для результата
    result_dict = {}

    # Для каждого значения из массива ищем совпадение
    for search_value in str_array:
        found = False

        # Проходим по всем строкам в столбце key_column
        for row in sheet.iter_rows(min_col=key_column, max_col=key_column):
            cell_value = row[0].value

            # Сравниваем со значением из массива (преобразуем оба к строке для надежности)
            if cell_value is not None and str(cell_value) == str(search_value):
                # Получаем значения из 3-го и 4-го столбцов
                col3_value = sheet.cell(row=row[0].row, column=value_columns[0]).value
                col4_value = sheet.cell(row=row[0].row, column=value_columns[1]).value

                result_dict[search_value] = (col3_value, col4_value, str_array[search_value][0], str_array[search_value][1])
                found = True
                break  # берем первое совпадение (если нужно последнее - уберите break)

        # Если значение не найдено, можно добавить None или пропустить
        if not found:
            result_dict[search_value] = (None, None)  # или просто не добавлять

    return result_dict




